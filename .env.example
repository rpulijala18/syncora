# ========================
# Syncora - Environment Variables
# Copy this file to .env.local for local dev
# Set these on Vercel Dashboard → Settings → Environment Variables
# ========================

# PostgreSQL Database URL (get free DB from https://neon.tech)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/syncora?sslmode=require"

# JWT Secret for auth sessions (generate a random 32-char string)
JWT_SECRET="your_super_secret_jwt_key_here_change_this"

# App URL (set to your Vercel domain or custom domain)
NEXT_PUBLIC_APP_URL="https://syncora.vercel.app"
